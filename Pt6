            continue
        for bal in (meta.get("postTokenBalances") or []):
            if bal.get("owner") != w["address"]:
                continue
            ui = bal.get("uiTokenAmount", {})
            try:
                value = float(ui.get("uiAmountString") or ui.get("uiAmount") or 0)
            except (TypeError, ValueError):
                continue
            if value + TOLERANCE >= amount:
                return {
                    "paid": True, "network": w["network"], "token": w["token"],
                    "amount_received": round(value, 6), "amount_expected": amount,
                    "txid": sig, "timestamp": block_time,
                }
