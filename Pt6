            "amount_expected": amount,
            "note": "activity found but no single transfer >= order amount"}
# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
_VERIFIERS = {"tron": verify_tron, "bsc": verify_bsc, "sol": verify_sol}
def verify_payment(network, amount, since_minutes=120):
    """Return a structured verification result for the given network."""
    fn = _VERIFIERS.get((network or "").lower())
    if not fn:
        return {"paid": False, "error": "unknown network: %s" % network}
    return fn(amount, since_minutes)
