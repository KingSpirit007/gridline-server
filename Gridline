# Signing
# ---------------------------------------------------------------------------

def sign_download(order_id, asset, exp):
    """HMAC-SHA256 over (order_id, asset, exp) — the delivery signature."""
    msg = "%s:%s:%s" % (order_id, asset, exp)
    return hmac.new(SECRET_KEY.encode("utf-8"), msg.encode("utf-8"),
                    hashlib.sha256).hexdigest()


def make_download_url(order_id, asset):
    exp = int(time.time()) + DOWNLOAD_TTL_SECONDS
    sig = sign_download(order_id, asset, exp)
    path = "/api/download?order=%s&asset=%s&exp=%s&sig=%s" % (
        order_id, asset, exp, sig)
    return (PUBLIC_BASE_URL.rstrip("/") + path) if PUBLIC_BASE_URL else path


