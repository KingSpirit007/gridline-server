"""Gridline — payment verification & delivery server.

A small, free-tier-deployable Flask API that:
  1. creates an order (with a receiving address for the chosen network),
  2. verifies the on-chain payment server-side (read-only, never moves funds),
  3. issues a time-limited HMAC-signed download URL only after payment is
     confirmed — closing the client-side bypass.

Endpoints
---------
  GET  /api/health
  GET  /api/products
  POST /api/create-order      {product, network}
  GET  /api/check-payment     ?order=<id>
  GET  /api/download          ?order=<id>&asset=<key>&exp=<ts>&sig=<hmac>

Run locally:  python3 app.py       (then open http://localhost:5000/api/health)
"""

import hashlib
