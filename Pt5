# Gridline payment & delivery API — production image.
# Build:  docker build -t gridline-api .
# Run:    docker run -p 5000:5000 --env-file .env gridline-api
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000
WORKDIR /app
# Install deps first for better layer caching.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# App code.
COPY . .
# SQLite lives on a writable path; mount a volume to persist it.
ENV DB_PATH=/data/gridline.db
RUN mkdir -p /data
EXPOSE 5000
# gunicorn: 2 workers is plenty for a free tier.
CMD ["sh", "-c", "gunicorn -b 0.0.0.0:${PORT} -w 2 --timeout 60 app:app"]
