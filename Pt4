# Render Blueprint — one-click free-tier deploy.
# Push this repo to GitHub, then in Render: New + -> Blueprint -> pick the repo.
# Render reads this file and provisions the service. Set the 3 wallet vars in
# the dashboard (marked sync:false so they are never stored in git).
services:
  - type: web
    name: gridline-api
    runtime: python
    plan: free
    region: oregon
    branch: main
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn -b 0.0.0.0:$PORT -w 2 --timeout 60 app:app
    healthCheckPath: /api/health
    autoDeploy: true
    envVars:
      - key: PYTHON_VERSION
        value: "3.11.9"
      - key: SECRET_KEY
        generateValue: true          # Render generates a strong secret for you
      - key: WALLET_USDT_TRC20
        sync: false                  # set in dashboard (never in git)
      - key: WALLET_USDC_BEP20
        sync: false
      - key: WALLET_USDC_SOLANA
        sync: false
      - key: ALLOWED_ORIGIN
        value: "*"                   # tighten to your storefront origin later
      - key: DOWNLOAD_TTL_SECONDS
        value: "86400"
      - key: ORDER_TTL_MINUTES
        value: "120"
